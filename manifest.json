{
  "manifest_version": 2,
  "name": "Hookless",
  "version": "1.1",
  "description": "Hide YouTube distractions. Turning it off takes a deliberate wait.",
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["storage"],
  "browser_action": {
    "default_icon": "icon.svg",
    "default_popup": "popup.html",
    "default_title": "Hookless"
  },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["features.js", "content.js"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "hookless@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
